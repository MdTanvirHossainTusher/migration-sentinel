# Migration Sentinel — local configuration. Copy to .env and adjust.
#   cp .env.example .env

PROFILE_ACTIVE=default
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=9091

# App metadata database (its own bookkeeping — NOT the DB migrations are reviewed against).
DB_HOST=localhost
DB_PORT=5440
DB_NAME=sentinel_db
DB_USERNAME=sentinel
DB_PASSWORD=sentinel

# Frontend origin allowed through CORS.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ── Agent brain ─────────────────────────────────────────────────────────────
# heuristic = offline, deterministic (default; runs with no API key).
# openai / gemini = real LLM reasoning on top of the same tools.
SENTINEL_LLM_PROVIDER=heuristic

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini API key from https://aistudio.google.com/api-keys (Google AI Studio).
# List models your key can use:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" | grep '"name"'
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ── Sandbox ─────────────────────────────────────────────────────────────────
# The disposable Postgres the agent's tools run DDL against. Needs a Docker daemon.
SENTINEL_SANDBOX_IMAGE=postgres:16-alpine
SENTINEL_SANDBOX_STATEMENT_TIMEOUT=45s

# Row estimate above which an ACCESS EXCLUSIVE lock / table rewrite is treated as HIGH.
SENTINEL_LARGE_TABLE_ROW_THRESHOLD=1000000

# ── Apply-rewrite (the one consequential action) ────────────────────────────
# Off by default. When on, rewrites are written ONLY under this directory, and
# only with an explicit confirm=true + approvedBy in the request.
SENTINEL_REWRITE_APPLY_ENABLED=false
SENTINEL_REWRITE_OUTPUT_DIR=./rewrites

# ── Messaging ───────────────────────────────────────────────────────────────
# local = in-process, after-commit dispatch (default; bootRun, tests).
# kafka = transactional outbox relayed to Kafka, consumed by a worker pool
#         (the compose stack sets this).
SENTINEL_MESSAGING_TRANSPORT=local
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SENTINEL_MESSAGING_CONSUMER_GROUP=sentinel-workers
SENTINEL_JOB_POOL_SIZE=2

# ── Secret encryption ───────────────────────────────────────────────────────
# base64 of 32 random bytes; used to encrypt a per-request LLM API key at rest.
# Generate: openssl rand -base64 32
# Unset = ephemeral key (single-process bootRun only).
SENTINEL_CRYPTO_SECRET=

# ── Object storage (presigned artifact upload / report download) ────────────
# Any S3 API; the compose stack runs RustFS. Off by default — with it off the
# report stays inline in the JSON response.
SENTINEL_S3_ENABLED=false
SENTINEL_S3_ENDPOINT_INTERNAL=http://localhost:9000
SENTINEL_S3_ENDPOINT_PUBLIC=http://localhost:9000
SENTINEL_S3_BUCKET=migration-sentinel
SENTINEL_S3_ACCESS_KEY=
SENTINEL_S3_SECRET_KEY=
SENTINEL_S3_REGION=us-east-1
SENTINEL_S3_MAX_FILE_SIZE=10MB

# Largest multipart upload the API itself will accept.
SENTINEL_MAX_UPLOAD_SIZE=5MB
