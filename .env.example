# Migration Sentinel — local configuration. Copy to .env and adjust.
#   cp .env.example .env

PROFILE_ACTIVE=default
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=9091

# App metadata database (its own bookkeeping — NOT the DB migrations are reviewed against).
DB_HOST=localhost
DB_PORT=5440
DB_NAME=sentinel_db
DB_USERNAME=sentinel
DB_PASSWORD=sentinel

# Frontend origin allowed through CORS.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ── Agent brain ─────────────────────────────────────────────────────────────
# heuristic = offline, deterministic (default; runs with no API key).
# openai / gemini = real LLM reasoning on top of the same tools.
SENTINEL_LLM_PROVIDER=heuristic

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Sandbox ─────────────────────────────────────────────────────────────────
# The disposable Postgres the agent's tools run DDL against. Needs a Docker daemon.
SENTINEL_SANDBOX_IMAGE=postgres:16-alpine
SENTINEL_SANDBOX_STATEMENT_TIMEOUT=45s

# Row estimate above which an ACCESS EXCLUSIVE lock / table rewrite is treated as HIGH.
SENTINEL_LARGE_TABLE_ROW_THRESHOLD=1000000

# ── Apply-rewrite (the one consequential action) ────────────────────────────
# Off by default. When on, rewrites are written ONLY under this directory, and
# only with an explicit confirm=true + approvedBy in the request.
SENTINEL_REWRITE_APPLY_ENABLED=false
SENTINEL_REWRITE_OUTPUT_DIR=./rewrites
